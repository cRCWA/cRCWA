# simulation of a dielectric layer in air (i.e. Fabry-Perot) resonances at various incident angle

let lambda=1.5e-6
let lambda0=1.3e-6
let Tx=3.2e-6
let ninc=1
let ndiel=4
let hdiel=lambda0/(2*ndiel)


fopen "test_output_angles.txt" "w"
let file=ans
for :angle 0 70 2 

	print " "
	print "ANGLE =" angle
	print " "
	clear
	
	size Tx 3.2e-6
	wavelength lambda
	harmonics 21 1
	carpet
	
	let theta=angle/180*3.14
	angles ninc theta 0

	# Air
	section 1e-6
		substrate ninc 0.0
		matdev nd

	# dielectric
	section hdiel
		substrate ndiel 0.0
		matdev nd
		
	# Air
	section 1e-6
		substrate 1 0.0
		matdev nd

	wants propagation
	solve
	assemble
		
	print "excitation theta =" theta 
	excitation f cy 1 0 0 0

	propagation Ey m 10e-9 1 1 Ey.txt
		
	# compute power
	select 1
	power f 1e-8
	let P=ans
	
	let z0=hdiel+1.2e-6
	powerZ z0
	let Pz=ans
	let T=Pz/P

	print theta
	print thetadiel=arcsin(ninc/ndiel*sin(theta))
	print Rinterf=((ndiel*cos(thetadiel)-ninc*cos(theta))/(ndiel*cos(thetadiel)+ninc*cos(theta)))^2
	print phi=4*3.14*ndiel*hdiel*cos(thetadiel)/lambda
	print Tref=((1-Rinterf)^2)/(1-2*Rinterf*cos(phi)+Rinterf^2)
	print err=abs((T-Tref)/Tref)
	
	fprint file angle P Pz T Tref err
	
	if (err>5e-3)
		fopen "ERROR.txt" "a"
		let fileErr=ans
		fprint fileErr "angles" angle err
		fclose fileErr
	endif
		
next :angle
fclose file

