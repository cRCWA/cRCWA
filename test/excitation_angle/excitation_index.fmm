# simulation of a dielectric layer in air (i.e. Fabry-Perot) resonances at various incident angle

let lambda=1.5e-6
let lambda0=1.3e-6
let Tx=10*3.2e-6
let ninc=1
let ndiel=4
let hdiel=lambda0/(2*ndiel)


fopen "test_output.txt" "w"
let file=ans

let angleIDmax=int(ninc*Tx/lambda)

for :angleID 0 angleIDmax 1 

	print " "
	print "ANGLE ID =" angleID " / " angleIDmax
	print " "
	clear
	
	
	size Tx 3.2e-6
	wavelength lambda
	harmonics 121 1

	# Air
	section 1e-6
		substrate ninc 0.0

	# dielectric
	section hdiel
		substrate ndiel 0.0
		
	# Air
	section 1e-6
		substrate 1 0.0

	wants propagation
	solve
	assemble
	

	excitation f cy 1 0 angleID 0
	let angle=ans(0)
	
	propagation Ey m 10e-9 1 1 Ey.txt
		
	# compute power
	select 1
	power f 1e-8
	let P=ans
	
	let z0=hdiel+1.01e-6
	powerZ z0
	let Pz=ans
	let T=Pz/P
	monitor z0 Tx 3.2e-6 0 0 

	print theta=angle/180.0*3.14
	print thetadiel=arcsin(ninc/ndiel*sin(theta))
	print Rinterf=((ndiel*cos(thetadiel)-ninc*cos(theta))/(ndiel*cos(thetadiel)+ninc*cos(theta)))^2
	print phi=4*3.14*ndiel*hdiel*cos(thetadiel)/lambda
	print Tref=((1-Rinterf)^2)/(1-2*Rinterf*cos(phi)+Rinterf^2)

	fprint file angle P Pz T Tref
		
next :angleID
fclose file

